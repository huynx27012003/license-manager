#!/usr/bin/env bash
set -euo pipefail

project_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
portal_dir="$( cd "$project_dir/../at-license-portal" && pwd )"

compose=(docker compose -f "$project_dir/docker-compose.local.yml")
set -a
source "$project_dir/.env"
set +a

cleanup() {
  echo ""
  echo "Stopping..."
  "${compose[@]}" down
}
trap cleanup EXIT

"${compose[@]}" build web
"${compose[@]}" up -d clickhouse

if ! psql -d "postgres:///at_license_dev" -tAc "select 1 from accounts where id = '${AT_LICENSE_ACCOUNT_ID}'" 2>/dev/null | grep -q 1; then
  echo "Running setup..."
  bundle exec rails at_license:setup
fi

"${compose[@]}" up -d web

echo ""
echo "========================================"
echo " AT-License API:  http://localhost:3000"
echo " AT-License Portal: http://localhost:5173"
echo " Sidekiq UI: http://localhost:3000/-/sidekiq/"
echo "========================================"
echo ""

pnpm --dir "$portal_dir" run dev
