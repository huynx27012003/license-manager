#!/usr/bin/env bash
set -euo pipefail

project_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
portal_dir="$( cd "$project_dir/../keygen-portal" && pwd )"

compose=(docker compose -f "$project_dir/docker-compose.local.yml")
set -a
source "$project_dir/.env"
set +a

cleanup() {
  echo ""
  echo "Stopping..."
  "${compose[@]}" down
}
trap cleanup EXIT

"${compose[@]}" build web setup
"${compose[@]}" up -d postgres clickhouse

if ! "${compose[@]}" exec -T postgres psql -U postgres -d keygen_dev -tAc "select 1 from accounts where id = '${KEYGEN_ACCOUNT_ID}'" 2>/dev/null | grep -q 1; then
  "${compose[@]}" --profile setup run --rm setup
fi

"${compose[@]}" up -d web

echo ""
echo "========================================"
echo " Keygen API:  http://localhost:3000"
echo " Keygen Portal: http://localhost:5173"
echo " Sidekiq UI: http://localhost:3000/-/sidekiq/"
echo "========================================"
echo ""

pnpm --dir "$portal_dir" run dev
